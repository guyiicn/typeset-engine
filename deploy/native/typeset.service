[Unit]
Description=typeset-engine HTTP rendering API (native deploy)
Documentation=https://github.com/guyiicn/typeset-engine/tree/deploy/native
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=typeset
Group=typeset

WorkingDirectory=/opt/typeset-native/app
Environment=PYTHONPATH=/opt/typeset-native/app

EnvironmentFile=/etc/typeset/typeset.env

ExecStart=/opt/typeset-native/.venv/bin/python /opt/typeset-native/app/scripts/server.py

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=typeset

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/typeset = OUTPUT_DIR (PDF/PPTX/PNG 输出)
# /opt/typeset-native/output = typst input .typ 中转 (学术/公文主题用,
#                              typst --root 限制 input 必须在 root 内, 不能直接用 OUTPUT_DIR)
ReadWritePaths=/var/lib/typeset /opt/typeset-native/output

[Install]
WantedBy=multi-user.target
