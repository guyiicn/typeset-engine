# typeset-engine 环境变量模板
# 由 install.sh 复制到 /etc/typeset/typeset.env (路径可调)
# ===== 由目标机 agent 按实际环境填充 =====

# ── 服务监听 ──────────────────────────────────────
PORT=9090
# 输出目录 (调用方契约, 改动需同步上层 SKILL.md)
OUTPUT_DIR=/var/lib/typeset/output

# ── Gemini API (AI PPT / AI 配图需要) ──────────────
# 留空则 /render/illustrate 和 /render/pptx-ai 失败, 其余功能正常
GEMINI_API_KEY=

# ── 代理设置 (内网部署必填) ────────────────────────
# 影响: Gemini API 调用. 系统包和 Chrome 由 install.sh 阶段单独处理.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# ── Python 路径 (一般无需改) ──────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
